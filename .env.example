# Teacher provider credentials. Copy to .env and fill in. NEVER commit .env.
# The pool (config/teachers.yaml) reads these variables; any subset works —
# unused providers are skipped.

# Primary teacher: four separate Google projects (independent free quotas)
GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_API_KEY4=

# Second opinion / fallback
OPENROUTER_API_KEY=

# Adjudicator for difficult cases (GLM)
ZAI_API_KEY=

# Legacy single-teacher fallback (OpenAI-compatible; optional)
TEACHER_BASE_URL=
TEACHER_API_KEY=
TEACHER_MODEL=
